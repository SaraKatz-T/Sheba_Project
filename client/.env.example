# העתיקו לקובץ .env ושנו לפי הצורך. אין כאן סודות: הסיסמה והמפתחות נמצאים רק בשרת.

# true = הלקוח עונה לעצמו עם שרת מדומה ונתונים מדומים.
# false = כל בקשה נשלחת לשרת הפייתון.
VITE_USE_MOCK=true

# כתובת שרת הפייתון. בזמן פיתוח Vite מעביר אליה כל בקשה ל-/api.
# דוגמה: http://192.168.1.30:8000
VITE_API_URL=

# true = שרת הפיתוח זמין גם ברשת המקומית, כדי שטלפון באותה רשת יוכל לפתוח את עמוד הצילום.
# בפעם הראשונה Windows עשוי לשאול אם לאפשר ל-Node.js גישה לרשת.
VITE_LAN=true

# לא חובה: הכתובת שהטלפון יפתח מקוד ה-QR, אם היא לא הכתובת שנפתחה במחשב.
# למשל כשהמערכת מוגשת מכתובת קבועה: https://forms.example.org
VITE_PUBLIC_URL=
